{
  "name": "typescript-learning-project",
  "version": "1.0.0",
  "description": "TypeScript learning guides and runnable practice workspaces.",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "typecheck:tooling-mini": "npm --prefix \"TypeScript tutorial/TypeScript Programming/tooling-integration/10-mini-project\" run typecheck",
    "typecheck:tsx-deep-dive": "npm --prefix \"TypeScript tutorial/TypeScript Programming/tsx-deep-dive\" run typecheck",
    "lint": "npm --prefix \"TypeScript tutorial/TypeScript Programming/tooling-integration/10-mini-project\" run lint",
    "test": "npm --prefix \"TypeScript tutorial/TypeScript Programming/tooling-integration/10-mini-project\" test",
    "build": "npm --prefix \"TypeScript tutorial/TypeScript Programming/tooling-integration/10-mini-project\" run build",
    "check": "npm run typecheck && npm run typecheck:tooling-mini && npm run typecheck:tsx-deep-dive && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
